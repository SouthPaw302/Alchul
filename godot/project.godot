; Alchul standalone Godot project (working reconstruction).
; No external plugins or cross-repository runtime dependencies.
config_version=5

[application]
config/name="Alchul — Living World (Study)"
run/main_scene="res://scenes/main.tscn"
config/description="Provisional Alchul native environment, independently contained in the canonical repo"

[display]
window/size/viewport_width=1280
window/size/viewport_height=720
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
environment/defaults/default_clear_color=Color(0.085, 0.13, 0.14, 1)

[physics]
3d/default_gravity=9.8

[application/run]
disable_stdout=false
